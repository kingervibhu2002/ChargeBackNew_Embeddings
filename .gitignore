# Qdrant local database (large binary files, recreated by running load_chargeback_docs.py)
qdrant_data/

# Python cache
__pycache__/
*.pyc
*.pyo
*.pyd
.Python

# Virtual environments
venv/
.venv/
env/

# Environment variables / secrets
.env
.env.local

# macOS
.DS_Store

# VS Code
.vscode/

# FastEmbed model cache (downloaded automatically on first run)
.cache/

# LangGraph checkpoints — SqliteSaver runs in WAL mode, so the -shm/-wal
# sidecar files need excluding alongside the main db file
checkpoints.db
checkpoints.db-shm
checkpoints.db-wal

# Audit log (contains query history — do not commit)
audit.log
